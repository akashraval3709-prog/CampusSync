<!-- 12. DATA DICTIONARY -->
<h1 class="page-break">DATA DICTIONARY</h1>
<p>The Data Dictionary provides complete schema specifications for all primary database entities in CampusSync.</p>

<h2>12.1 Table: users</h2>
<table>
    <thead><tr><th>Column Name</th><th>Data Type</th><th>Key / Constraint</th><th>Description</th></tr></thead>
    <tbody>
        <tr><td>id</td><td>INT</td><td>Primary Key, Auto Increment</td><td>Unique User Identification ID</td></tr>
        <tr><td>username</td><td>VARCHAR(50)</td><td>Unique, NOT NULL</td><td>Login ID (Enrollment No / Employee Code)</td></tr>
        <tr><td>password_hash</td><td>VARCHAR(255)</td><td>NOT NULL</td><td>scrypt-hashed cryptographic password string</td></tr>
        <tr><td>role</td><td>ENUM('Admin', 'Faculty', 'Student')</td><td>NOT NULL</td><td>Authorization access level</td></tr>
        <tr><td>is_active</td><td>BOOLEAN</td><td>Default: TRUE</td><td>Account operational status</td></tr>
        <tr><td>created_at</td><td>DATETIME</td><td>Current Timestamp</td><td>Record creation timestamp</td></tr>
    </tbody>
</table>
<div class="caption">Table 12.1: Data Dictionary — Users Master Table (users)</div>

<h2>12.2 Table: students</h2>
<table>
    <thead><tr><th>Column Name</th><th>Data Type</th><th>Key / Constraint</th><th>Description</th></tr></thead>
    <tbody>
        <tr><td>id</td><td>INT</td><td>Primary Key, Auto Increment</td><td>Unique Student Entity Identifier</td></tr>
        <tr><td>roll_number</td><td>VARCHAR(20)</td><td>NOT NULL</td><td>Classroom Roll Number</td></tr>
        <tr><td>enrollment_no</td><td>VARCHAR(30)</td><td>Unique, NOT NULL, Index</td><td>University Enrolment Code</td></tr>
        <tr><td>full_name</td><td>VARCHAR(100)</td><td>NOT NULL</td><td>Complete legal student name</td></tr>
        <tr><td>email</td><td>VARCHAR(100)</td><td>Unique, NOT NULL</td><td>Student contact email</td></tr>
        <tr><td>course</td><td>VARCHAR(50)</td><td>Default: 'BCA'</td><td>Academic degree program</td></tr>
        <tr><td>semester</td><td>INT</td><td>NOT NULL (1 to 6)</td><td>Currently active semester</td></tr>
        <tr><td>division</td><td>VARCHAR(5)</td><td>Default: 'A'</td><td>Enrolled division code</td></tr>
        <tr><td>academic_year</td><td>VARCHAR(20)</td><td>Default: '2026-27'</td><td>Enrolled academic year</td></tr>
        <tr><td>status</td><td>ENUM('Active', 'Alumni', 'Suspended')</td><td>Default: 'Active'</td><td>Current academic status</td></tr>
    </tbody>
</table>
<div class="caption">Table 12.2: Data Dictionary — Students Master Table (students)</div>

<h2>12.3 Table: internal_marks</h2>
<table>
    <thead><tr><th>Column Name</th><th>Data Type</th><th>Key / Constraint</th><th>Description</th></tr></thead>
    <tbody>
        <tr><td>id</td><td>INT</td><td>Primary Key, Auto Increment</td><td>Internal Mark Record ID</td></tr>
        <tr><td>student_id</td><td>INT</td><td>Foreign Key -&gt; students.id</td><td>Reference to student</td></tr>
        <tr><td>subject_id</td><td>INT</td><td>Foreign Key -&gt; subjects.id</td><td>Reference to subject</td></tr>
        <tr><td>marks_obtained</td><td>FLOAT</td><td>NOT NULL</td><td>Final calculated internal score</td></tr>
        <tr><td>max_marks</td><td>INT</td><td>NOT NULL</td><td>Maximum possible marks (25 / 30 / 50)</td></tr>
        <tr><td>test1, test2, test3</td><td>FLOAT</td><td>Nullable</td><td>Class Test 1, 2, 3 scores</td></tr>
        <tr><td>internal_exam</td><td>FLOAT</td><td>Nullable</td><td>Mid-term internal exam score</td></tr>
        <tr><td>active_learning</td><td>FLOAT</td><td>Nullable</td><td>Presentation / Seminar score</td></tr>
        <tr><td>class_assignment</td><td>FLOAT</td><td>Nullable</td><td>Assignment submission score</td></tr>
        <tr><td>attendance</td><td>FLOAT</td><td>Nullable</td><td>Score derived from attendance %</td></tr>
        <tr><td>practical_eval, viva, journal</td><td>FLOAT</td><td>Nullable</td><td>Practical evaluation scores</td></tr>
    </tbody>
</table>
