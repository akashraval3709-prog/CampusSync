        <tr><td><b>Server Operating System</b></td><td>Windows 10 / Ubuntu 20.04 LTS</td><td>Ubuntu 22.04 LTS Server</td></tr>
        <tr><td><b>Database Server</b></td><td>MySQL 8.0</td><td>MySQL 8.0 Enterprise</td></tr>
        <tr><td><b>Python Environment</b></td><td>Python 3.10.x</td><td>Python 3.11.x or higher</td></tr>
