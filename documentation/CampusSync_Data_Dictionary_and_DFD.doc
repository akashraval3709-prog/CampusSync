<!-- ========================================== -->
<!-- 2. DATA DICTIONARY                         -->
<!-- ========================================== -->
<h2>2. Data Dictionary</h2>

<p>
    A Data Dictionary is a centralized repository of information about data such as meaning, relationships to other data, origin, usage, and format. In the <strong>CampusSync ERP</strong> system, MySQL relational database is utilized to maintain institutional integrity across administrators, faculty members, enrolled students, daily QR attendance records, semester marks, and public website CMS content.
</p>

<!-- Table 1: students -->
<h3>2.1 Table Name: <code>students</code></h3>
<p><strong>Description:</strong> Stores comprehensive student profiles, credentials, academic enrollment, division, and session tracking.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Unique student identifier</td>
        </tr>
        <tr>
            <td><code>enrollment_number</code></td>
            <td>VARCHAR</td>
            <td>50, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>University/College Enrollment ID</td>
        </tr>
        <tr>
            <td><code>name</code></td>
            <td>VARCHAR</td>
            <td>150</td>
            <td>NO</td>
            <td>-</td>
            <td>Full legal name of student</td>
        </tr>
        <tr>
            <td><code>email</code></td>
            <td>VARCHAR</td>
            <td>150, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>Registered email for notifications/OTP</td>
        </tr>
        <tr>
            <td><code>password_hash</code></td>
            <td>VARCHAR</td>
            <td>255</td>
            <td>NO</td>
            <td>-</td>
            <td>Secure bcrypt/pbkdf2 password hash</td>
        </tr>
        <tr>
            <td><code>course</code></td>
            <td>VARCHAR</td>
            <td>50</td>
            <td>NO</td>
            <td>-</td>
            <td>Degree program (e.g. BCA, B.Sc. IT)</td>
        </tr>
        <tr>
            <td><code>semester</code></td>
            <td>INT</td>
            <td>1 to 6</td>
            <td>NO</td>
            <td>-</td>
            <td>Current semester number</td>
        </tr>
        <tr>
            <td><code>division</code></td>
            <td>VARCHAR</td>
            <td>10</td>
            <td>YES</td>
            <td>-</td>
            <td>Assigned division (A, B, C)</td>
        </tr>
        <tr>
            <td><code>roll_number</code></td>
            <td>INT</td>
            <td>-</td>
            <td>YES</td>
            <td>-</td>
            <td>Assigned class roll number</td>
        </tr>
        <tr>
            <td><code>academic_year</code></td>
            <td>VARCHAR</td>
            <td>20</td>
            <td>NO</td>
            <td>-</td>
            <td>Academic session (e.g. 2025-2026)</td>
        </tr>
        <tr>
            <td><code>status</code></td>
            <td>ENUM</td>
            <td>'Active', 'Inactive', 'Archived'</td>
            <td>NO</td>
            <td>-</td>
            <td>Enrollment lifecycle status</td>
        </tr>
        <tr>
            <td><code>created_at</code></td>
            <td>TIMESTAMP</td>
            <td>Default Current</td>
            <td>NO</td>
            <td>-</td>
            <td>Timestamp when account was created</td>
        </tr>
    </tbody>
</table>

<!-- Table 2: faculty -->
<h3>2.2 Table Name: <code>faculty</code></h3>
<p><strong>Description:</strong> Contains academic faculty member details, departmental affiliation, and portal credentials.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Unique faculty member ID</td>
        </tr>
        <tr>
            <td><code>faculty_id</code></td>
            <td>VARCHAR</td>
            <td>50, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>Institutional Employee/Staff ID</td>
        </tr>
        <tr>
            <td><code>name</code></td>
            <td>VARCHAR</td>
            <td>150</td>
            <td>NO</td>
            <td>-</td>
            <td>Professor / Instructor full name</td>
        </tr>
        <tr>
            <td><code>email</code></td>
            <td>VARCHAR</td>
            <td>150, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>Faculty official email address</td>
        </tr>
        <tr>
            <td><code>password_hash</code></td>
            <td>VARCHAR</td>
            <td>255</td>
            <td>NO</td>
            <td>-</td>
            <td>Secure password hash</td>
        </tr>
        <tr>
            <td><code>department</code></td>
            <td>VARCHAR</td>
            <td>100</td>
            <td>NO</td>
            <td>-</td>
            <td>Department (Computer Science, IT)</td>
        </tr>
        <tr>
            <td><code>designation</code></td>
            <td>VARCHAR</td>
            <td>100</td>
            <td>YES</td>
            <td>-</td>
            <td>Title (Assistant Professor, HOD)</td>
        </tr>
        <tr>
            <td><code>phone</code></td>
            <td>VARCHAR</td>
            <td>20</td>
            <td>YES</td>
            <td>-</td>
            <td>Faculty mobile contact number</td>
        </tr>
        <tr>
            <td><code>status</code></td>
            <td>ENUM</td>
            <td>'Active', 'Inactive'</td>
            <td>NO</td>
            <td>-</td>
            <td>Current service status</td>
        </tr>
    </tbody>
</table>

<!-- Table 3: admins -->
<h3>2.3 Table Name: <code>admins</code></h3>
<p><strong>Description:</strong> High-privileged institutional administrator accounts responsible for ERP control and configurations.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Unique admin identifier</td>
        </tr>
        <tr>
            <td><code>username</code></td>
            <td>VARCHAR</td>
            <td>50, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>Admin login handle</td>
        </tr>
        <tr>
            <td><code>name</code></td>
            <td>VARCHAR</td>
            <td>150</td>
            <td>NO</td>
            <td>-</td>
            <td>Full name of administrator</td>
        </tr>
        <tr>
            <td><code>email</code></td>
            <td>VARCHAR</td>
            <td>150, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>Admin alert & recovery email</td>
        </tr>
        <tr>
            <td><code>password_hash</code></td>
            <td>VARCHAR</td>
            <td>255</td>
            <td>NO</td>
            <td>-</td>
            <td>Hashed administrative password</td>
        </tr>
        <tr>
            <td><code>role</code></td>
            <td>VARCHAR</td>
            <td>50</td>
            <td>NO</td>
            <td>-</td>
            <td>Role type (SuperAdmin, StaffAdmin)</td>
        </tr>
    </tbody>
</table>

<!-- Table 4: subjects -->
<h3>2.4 Table Name: <code>subjects</code></h3>
<p><strong>Description:</strong> Defines all academic course curricula, theory/practical credits, and grading allocations.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Subject unique ID</td>
        </tr>
        <tr>
            <td><code>subject_code</code></td>
            <td>VARCHAR</td>
            <td>50, Unique</td>
            <td>NO</td>
            <td>UNIQUE</td>
            <td>Curriculum Subject Code (e.g. CS501)</td>
        </tr>
        <tr>
            <td><code>subject_name</code></td>
            <td>VARCHAR</td>
            <td>150</td>
            <td>NO</td>
            <td>-</td>
            <td>Title (e.g. Web Technology, Python)</td>
        </tr>
        <tr>
            <td><code>course</code></td>
            <td>VARCHAR</td>
            <td>50</td>
            <td>NO</td>
            <td>-</td>
            <td>Degree program (e.g. BCA)</td>
        </tr>
        <tr>
            <td><code>semester</code></td>
            <td>INT</td>
            <td>1 to 6</td>
            <td>NO</td>
            <td>-</td>
            <td>Semester curriculum semester</td>
        </tr>
        <tr>
            <td><code>total_lectures</code></td>
            <td>INT</td>
            <td>Default 60</td>
            <td>NO</td>
            <td>-</td>
            <td>Planned semester lecture sessions</td>
        </tr>
        <tr>
            <td><code>internal_marks</code></td>
            <td>INT</td>
            <td>Default 30</td>
            <td>NO</td>
            <td>-</td>
            <td>Max internal evaluation weightage</td>
        </tr>
    </tbody>
</table>

<!-- Table 5: faculty_subject_assignments -->
<h3>2.5 Table Name: <code>faculty_subject_assignments</code></h3>
<p><strong>Description:</strong> Bridges faculty members to specific course subjects and division classrooms.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Assignment identifier</td>
        </tr>
        <tr>
            <td><code>faculty_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>faculty.id</code></td>
        </tr>
        <tr>
            <td><code>subject_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>subjects.id</code></td>
        </tr>
        <tr>
            <td><code>division</code></td>
            <td>VARCHAR</td>
            <td>10</td>
            <td>YES</td>
            <td>-</td>
            <td>Target division (e.g. 'A')</td>
        </tr>
        <tr>
            <td><code>academic_year</code></td>
            <td>VARCHAR</td>
            <td>20</td>
            <td>NO</td>
            <td>-</td>
            <td>e.g. '2025-2026'</td>
        </tr>
    </tbody>
</table>

<!-- Table 6: attendance_records -->
<h3>2.6 Table Name: <code>attendance_records</code></h3>
<p><strong>Description:</strong> Real-time QR and manual student attendance transactions logged per lecture session.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Attendance transaction ID</td>
        </tr>
        <tr>
            <td><code>student_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>students.id</code></td>
        </tr>
        <tr>
            <td><code>subject_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>subjects.id</code></td>
        </tr>
        <tr>
            <td><code>faculty_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>faculty.id</code></td>
        </tr>
        <tr>
            <td><code>date</code></td>
            <td>DATE</td>
            <td>-</td>
            <td>NO</td>
            <td>-</td>
            <td>Lecture delivery date</td>
        </tr>
        <tr>
            <td><code>time_slot</code></td>
            <td>VARCHAR</td>
            <td>50</td>
            <td>YES</td>
            <td>-</td>
            <td>Lecture period slot (e.g. 09:00 - 10:00)</td>
        </tr>
        <tr>
            <td><code>status</code></td>
            <td>ENUM</td>
            <td>'Present', 'Absent'</td>
            <td>NO</td>
            <td>-</td>
            <td>Student attendance outcome</td>
        </tr>
        <tr>
            <td><code>method</code></td>
            <td>ENUM</td>
            <td>'QR', 'Manual'</td>
            <td>NO</td>
            <td>-</td>
            <td>Attendance capture mechanism</td>
        </tr>
        <tr>
            <td><code>marked_at</code></td>
            <td>TIMESTAMP</td>
            <td>Current Timestamp</td>
            <td>NO</td>
            <td>-</td>
            <td>Exact timestamp when scan happened</td>
        </tr>
    </tbody>
</table>

<!-- Table 7: internal_marks -->
<h3>2.7 Table Name: <code>internal_marks</code></h3>
<p><strong>Description:</strong> Semester evaluation breakdown per subject (Unit tests, assignments, attendance component).</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Marks entry ID</td>
        </tr>
        <tr>
            <td><code>student_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>students.id</code></td>
        </tr>
        <tr>
            <td><code>subject_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>NO</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>subjects.id</code></td>
        </tr>
        <tr>
            <td><code>unit_test</code></td>
            <td>FLOAT</td>
            <td>Default 0.0</td>
            <td>NO</td>
            <td>-</td>
            <td>Mid-term / Unit test score</td>
        </tr>
        <tr>
            <td><code>assignment_marks</code></td>
            <td>FLOAT</td>
            <td>Default 0.0</td>
            <td>NO</td>
            <td>-</td>
            <td>Continuous assignment score</td>
        </tr>
        <tr>
            <td><code>attendance_marks</code></td>
            <td>FLOAT</td>
            <td>Default 0.0</td>
            <td>NO</td>
            <td>-</td>
            <td>Attendance compliance weightage</td>
        </tr>
        <tr>
            <td><code>total_internal</code></td>
            <td>FLOAT</td>
            <td>Default 0.0</td>
            <td>NO</td>
            <td>-</td>
            <td>Aggregated internal total (out of 30)</td>
        </tr>
        <tr>
            <td><code>submitted_by_id</code></td>
            <td>INT</td>
            <td>-</td>
            <td>YES</td>
            <td><span class="badge-fk">FOREIGN KEY</span></td>
            <td>References <code>faculty.id</code></td>
        </tr>
    </tbody>
</table>

<!-- Table 8: notifications -->
<h3>2.8 Table Name: <code>notifications</code></h3>
<p><strong>Description:</strong> Campus circulars, exam schedules, and holiday announcements published across portals.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Circular notification ID</td>
        </tr>
        <tr>
            <td><code>title</code></td>
            <td>VARCHAR</td>
            <td>200</td>
            <td>NO</td>
            <td>-</td>
            <td>Circular headline</td>
        </tr>
        <tr>
            <td><code>message</code></td>
            <td>TEXT</td>
            <td>-</td>
            <td>NO</td>
            <td>-</td>
            <td>Detailed body text of announcement</td>
        </tr>
        <tr>
            <td><code>category</code></td>
            <td>VARCHAR</td>
            <td>50</td>
            <td>NO</td>
            <td>-</td>
            <td>Category (Exam, Holiday, Event)</td>
        </tr>
        <tr>
            <td><code>target_audience</code></td>
            <td>ENUM</td>
            <td>'All', 'Student', 'Faculty', 'Public'</td>
            <td>NO</td>
            <td>-</td>
            <td>Access permission filter</td>
        </tr>
        <tr>
            <td><code>photo_file</code></td>
            <td>VARCHAR</td>
            <td>255</td>
            <td>YES</td>
            <td>-</td>
            <td>Attached PDF/image document path</td>
        </tr>
        <tr>
            <td><code>is_public</code></td>
            <td>BOOLEAN</td>
            <td>Default False</td>
            <td>NO</td>
            <td>-</td>
            <td>Display on public landing notice board</td>
        </tr>
    </tbody>
</table>

<!-- Table 9: gallery_items -->
<h3>2.9 Table Name: <code>gallery_items</code></h3>
<p><strong>Description:</strong> Stores photographs across Campus Life, Events, Sports, Academics, Achievements, and Celebrations.</p>
<table>
    <thead>
        <tr>
            <th>Field Name</th>
            <th>Data Type</th>
            <th>Size / Constraints</th>
            <th>Nullable</th>
            <th>Key</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>id</code></td>
            <td>INT</td>
            <td>Auto-Increment</td>
            <td>NO</td>
            <td><span class="badge-pk">PRIMARY KEY</span></td>
            <td>Gallery photo unique ID</td>
        </tr>
        <tr>
            <td><code>title</code></td>
            <td>VARCHAR</td>
            <td>150</td>
            <td>NO</td>
            <td>-</td>
            <td>Photo title / Caption</td>
        </tr>
        <tr>
            <td><code>category</code></td>
            <td>VARCHAR</td>
            <td>50</td>
            <td>NO</td>
            <td>-</td>
            <td>Category (e.g. Sports, Celebrations)</td>
        </tr>
        <tr>
            <td><code>description</code></td>
            <td>TEXT</td>
            <td>-</td>
            <td>YES</td>
            <td>-</td>
            <td>Detailed caption / context</td>
        </tr>
        <tr>
            <td><code>image_file</code></td>
            <td>VARCHAR</td>
            <td>255</td>
            <td>NO</td>
            <td>-</td>
            <td>Uploaded filename in <code>uploads/gallery</code></td>
        </tr>
        <tr>
            <td><code>is_featured</code></td>
            <td>BOOLEAN</td>
            <td>Default False</td>
            <td>NO</td>
            <td>-</td>
            <td>Feature on homepage landing carousel</td>
        </tr>
        <tr>
            <td><code>views_count</code></td>
            <td>INT</td>
            <td>Default 0</td>
            <td>NO</td>
            <td>-</td>
            <td>Total views logged by viewers</td>
        </tr>
        <tr>
            <td><code>status</code></td>
            <td>ENUM</td>
            <td>'Active', 'Inactive'</td>
            <td>NO</td>
            <td>-</td>
            <td>Public visibility status</td>
        </tr>
    </tbody>
</table>

