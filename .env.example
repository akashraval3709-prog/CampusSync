# ========================================================
# CampusSync - Environment Configuration Template
# ========================================================
# Duplicate this file as .env and update with your production settings.

# Secret Key (Set a random string in production for secure sessions)
SECRET_KEY=generate_a_random_secret_key_here_for_production

# --------------------------------------------------------
# Database Configuration
# --------------------------------------------------------
# Option A: Cloud Database URL (Recommended for Render, Railway, PythonAnywhere, AWS)
# Example: DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name
# DATABASE_URL=

# Option B: Individual MySQL Parameters (e.g. Local XAMPP, cPanel, VPS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campussync
DB_USER=root
DB_PASSWORD=

# --------------------------------------------------------
# Mail SMTP Configuration (Password Reset, Welcome Emails)
# --------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# --------------------------------------------------------
# Server Configuration (Optional)
# --------------------------------------------------------
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=False
